# One line per lab login, nginx htpasswd format with {SHA} (base64 of SHA-1).
# Generate a line:  node -e "console.log('noble:{SHA}'+require('crypto').createHash('sha1').update('PASSWORD').digest('base64'))"
# Real file: deploy/htpasswd (git-ignored), mounted into the container by docker-compose.yml.
noble:{SHA}REPLACE_ME
